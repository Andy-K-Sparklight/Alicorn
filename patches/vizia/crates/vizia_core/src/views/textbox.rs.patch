+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::events::EventManager;
+    use skia_safe::FontMgr;
+    use skia_safe::textlayout::{FontCollection, ParagraphBuilder, ParagraphStyle, TextStyle};
+
+    /// Caret anchors use UTF-16 ranges for graphemes and the final layout sentinel.
+    #[test]
+    fn caret_range_unicode() {
+        for (text, active, expected) in [
+            ("", 0, (0..1, false)),
+            ("a", 1, (0..1, true)),
+            ("a\n", 2, (2..3, false)),
+            ("\n\n", 2, (2..3, false)),
+            ("a\r\n", 3, (3..4, false)),
+            ("😀e\u{301}\n", 8, (5..6, false)),
+            ("😀e\u{301}", 4, (2..4, false)),
+            ("😀e\u{301}", 7, (2..4, true)),
+            ("😀e\u{301}", 1, (0..2, false)),
+            ("😀e\u{301}", 6, (2..4, false)),
+            ("", 10, (0..1, false)),
+        ] {
+            assert_eq!(caret_range(text, active), expected, "Caret range should match");
+        }
+    }
+
+    /// Skia places the end caret on the final empty line, including wrapped Unicode text.
+    #[test]
+    fn caret_geometry_final_line() {
+        let mut fonts = FontCollection::new();
+        fonts.set_default_font_manager(FontMgr::default(), None);
+        for text in ["", "\n", "hello\n", "hello\n\n", "hello\r\n", "😀e\u{301}中文\n"] {
+            for width in [30.0, 400.0] {
+                let mut style = ParagraphStyle::new();
+                style.set_text_style(TextStyle::new().set_font_size(16.0));
+                let mut builder = ParagraphBuilder::new(&style, fonts.clone());
+                builder.add_text(text).add_text("\u{200B}");
+                let mut paragraph = builder.build();
+                paragraph.layout(width);
+                let (range, trailing) = caret_range(text, text.len());
+                let rects = paragraph.get_rects_for_range(
+                    range,
+                    RectHeightStyle::Tight,
+                    RectWidthStyle::Tight,
+                );
+                let rect = &rects.first().expect("Final line should have a caret anchor").rect;
+                let lines = paragraph.get_line_metrics();
+                let line = lines.last().expect("Paragraph should contain a line");
+                assert!(!trailing, "Final empty line should use the leading edge");
+                assert!(
+                    rect.top <= line.baseline as f32 && rect.bottom >= line.baseline as f32,
+                    "Caret should span the final line baseline for {text:?}"
+                );
+                assert!(rect.height() > 0.0, "Caret should have visible height");
+            }
+        }
+    }
+
+    /// Both Enter keys insert one newline in editable multiline textboxes and preserve read-only text.
+    #[test]
+    fn textbox_enter_multiline() {
+        for code in [Code::Enter, Code::NumpadEnter] {
+            for read_only in [false, true] {
+                let mut cx = Context::default();
+                cx.windows.insert(Entity::root(), crate::context::WindowState::default());
+                let value = Signal::new(String::new());
+                let entity = Textbox::new_multiline(&mut cx, value, true)
+                    .read_only(read_only)
+                    .on_edit(move |_, text| value.set(text))
+                    .entity();
+                let mut events = EventManager::new();
+                cx.emit_custom(Event::new(TextEvent::StartEdit).target(entity));
+                events.flush_events(&mut cx, |_| {});
+                cx.emit_custom(Event::new(WindowEvent::KeyDown(code, None)).target(entity));
+                events.flush_events(&mut cx, |_| {});
+                assert_eq!(
+                    value.get(),
+                    if read_only { "" } else { "\n" },
+                    "Enter should respect multiline read-only state"
+                );
+            }
+        }
+    }
+
+    /// Both Enter keys submit a single-line textbox without inserting a newline.
+    #[test]
+    fn textbox_enter_singleline() {
+        for code in [Code::Enter, Code::NumpadEnter] {
+            let mut cx = Context::default();
+            cx.windows.insert(Entity::root(), crate::context::WindowState::default());
+            let value = Signal::new(String::from("hello"));
+            let submitted = Signal::new(None);
+            let entity = Textbox::new(&mut cx, value)
+                .on_submit(move |_, text, enter| submitted.set(Some((text, enter))))
+                .entity();
+            let mut events = EventManager::new();
+            cx.emit_custom(Event::new(TextEvent::StartEdit).target(entity));
+            events.flush_events(&mut cx, |_| {});
+            cx.emit_custom(Event::new(WindowEvent::KeyDown(code, None)).target(entity));
+            events.flush_events(&mut cx, |_| {});
+            assert_eq!(
+                submitted.get(),
+                Some((String::from("hello"), true)),
+                "Enter should submit the unchanged value"
+            );
+        }
+    }
+}
