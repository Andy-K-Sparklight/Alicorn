+/// Returns a UTF-16 paragraph range and whether its trailing edge anchors the caret.
+///
+/// `active` is a UTF-8 byte offset; offsets within a grapheme use its leading edge,
+/// and offsets beyond the text use its end. Empty text and a final hard break use
+/// the zero-width space appended by the paragraph builder.
+fn caret_range(text: &str, active: usize) -> (Range<usize>, bool) {
+    let mut previous = 0..0;
+    for (byte, grapheme) in text.grapheme_indices(true) {
+        let range = previous.end..previous.end + grapheme.encode_utf16().count();
+        if active < byte + grapheme.len() {
+            return (range, false);
+        }
+        previous = range;
+    }
+    if text.is_empty() || text.ends_with(['\n', '\r']) {
+        (previous.end..previous.end + 1, false)
+    } else {
+        (previous, true)
+    }
+}
